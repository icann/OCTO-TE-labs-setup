$TTL    30
@       IN      SOA     %DOMAIN%. te-labs.icann.org. (                                            
                              1         ; Serial
                             30         ; Refresh
                             30         ; Retry
                             30         ; Expire
                             30 )       ; Negative Cache TTL
@           A           %IPv4%
@           AAAA        %IPv6%
@           MX          0 .
@           NS          %DOMAIN%.
@           TXT         "v=spf1 -all"
ipv4only    A           %IPv4%
ipv6only    AAAA        %IPv6%
shellinabox CNAME       %DOMAIN%.
