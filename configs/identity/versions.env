# OCTO-TE Labs identity software version manifest
#
# External release artifacts are pinned to versions and SHA-256 checksums
# validated in a dedicated disposable environment.
#
# Ubuntu package revisions are intentionally not pinned here. Redis and
# SQLite follow the supported Ubuntu 24.04 Noble repositories, while their
# expected major-version families are validated after installation.

IDENTITY_VERSION_MANIFEST="1"

IDENTITY_TARGET_OS_ID="ubuntu"
IDENTITY_TARGET_OS_VERSION_ID="24.04"
IDENTITY_TARGET_DPKG_ARCH="amd64"
IDENTITY_TARGET_MACHINE_ARCH="x86_64"

AUTHELIA_GITHUB_REPOSITORY="authelia/authelia"
AUTHELIA_VERSION="4.39.22"
AUTHELIA_RELEASE_TAG="v${AUTHELIA_VERSION}"
AUTHELIA_ARCHIVE="authelia-v${AUTHELIA_VERSION}-linux-amd64.tar.gz"
AUTHELIA_ARCHIVE_BINARY="authelia"
AUTHELIA_SHA256="15ea0538c3a795f8698fdee734e4f775446151d335e6daeb2f8e92063f865ddd"
AUTHELIA_URL="https://github.com/${AUTHELIA_GITHUB_REPOSITORY}/releases/download/${AUTHELIA_RELEASE_TAG}/${AUTHELIA_ARCHIVE}"

OAUTH2_PROXY_GITHUB_REPOSITORY="oauth2-proxy/oauth2-proxy"
OAUTH2_PROXY_VERSION="7.15.4"
OAUTH2_PROXY_RELEASE_TAG="v${OAUTH2_PROXY_VERSION}"
OAUTH2_PROXY_ARCHIVE="oauth2-proxy-v${OAUTH2_PROXY_VERSION}.linux-amd64.tar.gz"
OAUTH2_PROXY_ARCHIVE_BINARY="oauth2-proxy-v${OAUTH2_PROXY_VERSION}.linux-amd64/oauth2-proxy"
OAUTH2_PROXY_SHA256="4fbe902189aab713d9c0519b90a645032d4636ecb523dc36f5cc312d8ebef1e2"
OAUTH2_PROXY_URL="https://github.com/${OAUTH2_PROXY_GITHUB_REPOSITORY}/releases/download/${OAUTH2_PROXY_RELEASE_TAG}/${OAUTH2_PROXY_ARCHIVE}"

REDIS_SERVER_PACKAGE="redis-server"
REDIS_TOOLS_PACKAGE="redis-tools"
REDIS_EXPECTED_MAJOR="7"

SQLITE_PACKAGE="sqlite3"
SQLITE_EXPECTED_MAJOR="3"
