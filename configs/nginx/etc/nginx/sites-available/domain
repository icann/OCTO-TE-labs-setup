## /etc/nginx/sites-enabled/LAB_DOMAIN.te-labs.training

# HTTP
server {
    listen 80;
    listen [::]:80;
    server_name %AuthDomain%;
    return 301 https://$host$request_uri;
}

# get access to our session cookie
map $remote_user $set_session_cookie {
    ""      "";
    default "session=%MAGIC_COOKIE_VALUE%; Path=/; Secure; HttpOnly";
}
map $cookie_session $authenticated {
    default 0;
    %MAGIC_COOKIE_VALUE% 1;
}

# HTTPS
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name %AuthDomain%;
    
    error_page 497 https://$host:$server_port$request_uri; # Enforce redirection of http to https
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always; # HSTS

    root /var/www/%AuthDomain%/html;
    index index.php index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ \.php$ {
        #NOTE: You should have "cgi.fix_pathinfo = 0;" in php.ini
        include fastcgi.conf;
        fastcgi_pass unix:/run/php/php-fpm.sock;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_index index.php;
        add_header Set-Cookie $set_session_cookie;
    }

    # webssh
	location /webssh/ {
        if ($authenticated = 0) {
                return 401;
        }

	    proxy_pass http://localhost:8888/;
	    proxy_http_version 1.1;
	    proxy_read_timeout 3600;
	    proxy_set_header Upgrade $http_upgrade;
	    proxy_set_header Connection "upgrade";
	    proxy_set_header Host $http_host;
	    proxy_set_header X-Real-IP $remote_addr;
	    proxy_set_header X-Real-PORT $remote_port;
        proxy_set_header Authorization "";
    }

    %grpX_locations%

}
